# Django Settings
SECRET_KEY=django-insecure-spotter-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing Provider Configuration
# Supported providers: 'osrm' (default, free demo server), 'openrouteservice' (requires API key), 'mock' (dev/testing)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
OPENROUTESERVICE_API_KEY=

# Geocoding Configuration
# Nominatim OpenStreetMap requires a descriptive User-Agent header
GEOCODING_USER_AGENT=weather-aware-truck-routing/1.0

# Mock routing mode (Only permitted when DEBUG=True for offline development or testing)
USE_MOCK_ROUTING=False
